theorem PEqualNP.Outside.V_meta_9600__k3 : PEqualNP.MetaComplexity.HasCircuitSize 4 (fun x : Fin 4 → Bool => (34944 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) 3 ∧
  ∀ t : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 4 (fun x : Fin 4 → Bool => (34944 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) t → 3 ≤ t :=
  ⟨PEqualNP.Outside.V_meta_9600__k3.upper, PEqualNP.Outside.V_meta_9600__k3.lower⟩
