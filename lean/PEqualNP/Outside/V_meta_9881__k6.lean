theorem unsat : ¬ FormulaSat F :=
  checkW_sound F c_K 12 c_P (by decide +kernel)

/-- Every circuit of AND, OR and NOT gates of fan-in at most two computing the function on 4
inputs has at least 6 gates. -/
theorem lower : ∀ t : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 4 (fun x : Fin 4 → Bool => (10408 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) t →
    6 ≤ t :=
  size_of_unsat2 4 5 fn rows (by decide) unsat

/-- The circuit of 6 gates computing the function. -/
def w : PEqualNP.CircuitLowerBounds.Circuit := ⟨[⟨PEqualNP.CircuitLowerBounds.GateOp.and, [1, 2]⟩, ⟨PEqualNP.CircuitLowerBounds.GateOp.or, [1, 2]⟩, ⟨PEqualNP.CircuitLowerBounds.GateOp.and, [0, 5]⟩, ⟨PEqualNP.CircuitLowerBounds.GateOp.and, [3, 4]⟩, ⟨PEqualNP.CircuitLowerBounds.GateOp.not, [7]⟩, ⟨PEqualNP.CircuitLowerBounds.GateOp.and, [6, 8]⟩], 9⟩

theorem fint : PEqualNP.MetaComplexity.FanInTwo w := by
  intro g hg
  simp only [w, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl <;> simp

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem upper : PEqualNP.MetaComplexity.HasCircuitSize 4 (fun x : Fin 4 → Bool => (10408 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) 6 :=
  ⟨w, fint, by decide, by decide +kernel⟩

